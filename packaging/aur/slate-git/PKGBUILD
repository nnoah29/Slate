# Maintainer: Noah Toffa <iam@toffanoah.com>
pkgname=slate-git
_pkgname=slate
pkgver=0.1.0.r17.gbb714de
pkgrel=1
pkgdesc="Minimalist native Linux Markdown notes application"
arch=('x86_64' 'aarch64')
url="https://github.com/nnoah29/Slate"
license=('MIT')
depends=('gtk4' 'libadwaita' 'gtksourceview5')
makedepends=('cargo' 'git')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+https://github.com/nnoah29/Slate.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$_pkgname"
  if git describe --long --tags --abbrev=7 >/dev/null 2>&1; then
    git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

build() {
  cd "$srcdir/$_pkgname"
  export CARGO_TARGET_DIR=target
  cargo build --release --locked
}

check() {
  cd "$srcdir/$_pkgname"
  cargo test --release --locked
}

package() {
  cd "$srcdir/$_pkgname"
  install -Dm755 target/release/slate "$pkgdir/usr/bin/slate"
  install -Dm644 data/com.github.slate.Slate.desktop "$pkgdir/usr/share/applications/com.github.slate.Slate.desktop"
  install -Dm644 data/com.github.slate.Slate.metainfo.xml "$pkgdir/usr/share/metainfo/com.github.slate.Slate.metainfo.xml"
  install -Dm644 data/icons/hicolor/scalable/apps/com.github.slate.Slate.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.github.slate.Slate.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
